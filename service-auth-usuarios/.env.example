# Copia este archivo a .env (NO lo subas a Git) y configura estas variables en tu entorno / run configuration.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/talleres_ph_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=cambia_esta_clave
# Genera un secreto nuevo: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION=86400000
DEFAULT_ROLE=VECINO
